# ===== MAIN BRAIN: change to gemini or xai =====
# This one line picks the brain for every agent that has no BRAIN_<AGENT>=... line of its own in this file.
# Pinned in matrix/config.py: STEWARD stays on xai (Grok) and BEZEL on gemini whatever this line says,
# unless you add a line here such as BRAIN_STEWARD=gemini. Options: gemini, xai, or mock (offline:
# no AI at all, pinned agents included). A typo keeps the previous brain and logs a warning.
# The Keeper worker re-reads this file every sweep, so a change takes effect within about 10 seconds, no restart.
LLM_PROVIDER=mock

# Copy this file to ".env" and fill in. Never share or commit the real .env file.
# IMPORTANT: every line must be plain KEY=value. No comments on the same line as a value.

# --- Agent service ---
# Only needed if LLM_PROVIDER=gemini (key from aistudio.google.com)
GOOGLE_API_KEY=
# Only needed if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER=xai (key from console.x.ai)
XAI_API_KEY=
# gemini-2.5-pro returns 404 for new accounts; use gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.1-pro-preview
CLAUDE_MODEL=claude-sonnet-4-5
# grok-4.6 is the default; grok-4.3 is a cheaper option
XAI_MODEL=grok-4.6
# Per-agent brains (optional). Defaults: STEWARD=xai (Grok), BEZEL=gemini, others use LLM_PROVIDER.
# One line per agent: BRAIN_<AGENT>=provider or provider:model (xai, gemini or claude), e.g.
# BRAIN_TAPER=xai:grok-4.3
# Scout web search (optional, read-only). No key = Scout off.
TAVILY_API_KEY=
# Max Scout searches per job (1 per task at most). 0 = off.
SCOUT_MAX_SEARCHES_PER_JOB=2
# Long random string; n8n sends it as X-Matrix-Key (required on a server)
MATRIX_API_KEY=
# Your numeric Telegram user id; only you can approve
OWNER_TELEGRAM_ID=
TIMEZONE=America/Edmonton

# --- Server only (docker-compose) ---
POSTGRES_USER=matrix
POSTGRES_PASSWORD=change-me-long-random
# Back this up! Lose it = lose saved n8n credentials
N8N_ENCRYPTION_KEY=change-me-long-random
# Your domain from Cloudflare Tunnel
N8N_HOST=n8n.example.ca
# From Cloudflare Zero Trust dashboard (step 4)
CLOUDFLARE_TUNNEL_TOKEN=
