# Copy this file to ".env" and fill in. Never share or commit the real .env file.
# IMPORTANT: every line must be plain KEY=value. No comments on the same line as a value.

# --- Agent service ---
# LLM_PROVIDER: mock (no key, offline) | gemini | claude | xai (Grok)
LLM_PROVIDER=mock
# Only needed if LLM_PROVIDER=gemini (key from aistudio.google.com)
GOOGLE_API_KEY=
# Only needed if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER=xai (key from console.x.ai)
XAI_API_KEY=
# gemini-2.5-pro returns 404 for new accounts; use gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.1-pro-preview
CLAUDE_MODEL=claude-sonnet-4-5
# grok-4.6 is the default; grok-4.3 is a cheaper option
XAI_MODEL=grok-4.6
# Long random string; n8n sends it as X-Matrix-Key (required on a server)
MATRIX_API_KEY=
# Your numeric Telegram user id; only you can approve
OWNER_TELEGRAM_ID=
TIMEZONE=America/Edmonton

# --- Server only (docker-compose) ---
POSTGRES_USER=matrix
POSTGRES_PASSWORD=change-me-long-random
# Back this up! Lose it = lose saved n8n credentials
N8N_ENCRYPTION_KEY=change-me-long-random
# Your domain from Cloudflare Tunnel
N8N_HOST=n8n.example.ca
# From Cloudflare Zero Trust dashboard (step 4)
CLOUDFLARE_TUNNEL_TOKEN=
